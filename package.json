{
  "name": "smart-expert-enterprise",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/download-speaker-model.mjs && node scripts/download-vad-model.mjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild scripts/migrate.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/migrate.cjs && mkdir -p dist/models && cp -n models/*.onnx dist/models/ 2>/dev/null || true",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:prod": "node dist/migrate.cjs",
    "test:unit": "node --experimental-strip-types --test --test-reporter=spec tests/*.unit.test.ts",
    "test:speaker": "node --experimental-strip-types --test tests/speaker_registry.unit.test.ts",
    "speaker:download-model": "node scripts/download-speaker-model.mjs",
    "speaker:verify-model": "node --experimental-strip-types scripts/verify-speaker-model.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "verify:release": "npm run lint && npm run test:unit && npm run speaker:verify-model && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "exceljs": "^4.4.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.1",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "sherpa-onnx-node": "^1.13.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.21.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
